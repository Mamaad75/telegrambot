# Core
NODE_ENV=production
PORT=3002
PUBLIC_BASE_URL=https://jarchii.example.com
DATABASE_URL=postgresql://jarchi:CHANGE_ME@127.0.0.1:5432/jarchi
PLATFORM_CREDENTIAL_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Reverse proxy: production defaults safely to loopback. Set explicitly when needed.
TRUST_PROXY=loopback

# Telegram / Bale
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://jarchii.example.com/telegram-webhook
TELEGRAM_WEBHOOK_SECRET_TOKEN=
BALE_BOT_TOKEN=
BALE_WEBHOOK_URL=https://jarchii.example.com/bale-webhook
BALE_API_BASE=https://tapi.bale.ai

# Admin bootstrap
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME
ADMIN_TELEGRAM_ID=
ADMIN_API_TOKEN=
ADMIN_COOKIE_SECURE=true

# Optional integrations
WHATSAPP_ENABLED=false
ZARINPAL_ENABLED=false
AI_ENABLED=false

# Runtime
RATE_LIMIT_ENABLED=true
EXPIRY_NOTICE_DAYS=3,1
EXPIRY_SCAN_INTERVAL_MS=3600000
LOG_LEVEL=info
