###############################################################################
# Baimar Lead Intelligence — environment
#
# Copy to `.env` and fill in. Everything marked OPTIONAL can be left empty:
# the platform starts, and the corresponding integration simply reports
# "Not configured" in Settings → Integrations.
#
# NEVER commit a filled-in .env. Secrets are read by the API process only and
# are never sent to the browser.
###############################################################################

# ---------------------------------------------------------------------------
# Core (REQUIRED)
# ---------------------------------------------------------------------------
NODE_ENV=development
# Port the API (Fastify) listens on.
API_PORT=4000
API_HOST=0.0.0.0
# Public origin of the web dashboard. Used for CORS and for links in notifications.
WEB_ORIGIN=http://localhost:3000
# Public base URL of the API as seen by the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostgreSQL connection string.
DATABASE_URL=postgresql://baimar:baimar@localhost:5432/baimar?schema=public
# Redis connection string, used for BullMQ queues, caching and rate limiting.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Security (REQUIRED — generate your own, never reuse these)
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-64-char-random-hex-string
JWT_ACCESS_TTL=900            # seconds; access token lifetime (15 min)
JWT_REFRESH_TTL=2592000       # seconds; refresh token lifetime (30 days)
# 32-byte hex key used to encrypt provider secrets at rest in the database.
APP_ENCRYPTION_KEY=change-me-to-a-64-char-random-hex-string
# Comma-separated extra origins allowed by CORS.
CORS_EXTRA_ORIGINS=

# First administrator, created by `npm run db:seed` if no user exists.
SEED_ADMIN_EMAIL=admin@baimar.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Baimar Admin

# ---------------------------------------------------------------------------
# Crawler / website audit (safe defaults — be a good citizen)
# ---------------------------------------------------------------------------
# Sent on every outgoing request so site owners can identify and contact us.
CRAWLER_USER_AGENT=BaimarLeadIntelligenceBot/1.0 (+https://baimar.ir/bot)
# Honour robots.txt. Leave `true` in production.
CRAWLER_RESPECT_ROBOTS=true
# Max pages fetched per website during an audit.
CRAWLER_MAX_PAGES=8
# Per-request timeout in milliseconds.
CRAWLER_TIMEOUT_MS=15000
# Delay between two requests to the same host, milliseconds.
CRAWLER_DELAY_MS=1500
# Hard cap on downloaded bytes per page.
CRAWLER_MAX_BYTES=2500000
# Concurrent website audits across the whole worker.
CRAWLER_CONCURRENCY=3

# ---------------------------------------------------------------------------
# Queue / workers
# ---------------------------------------------------------------------------
QUEUE_PREFIX=baimar
WORKER_CONCURRENCY=4
# Run queue workers inside the API process. Set to false when running a
# dedicated worker container (recommended in production).
RUN_WORKERS_IN_API=true

# ---------------------------------------------------------------------------
# OPTIONAL — AI providers. Leave empty to run the platform without AI:
# deterministic rules still produce scores, opportunities and a sales brief.
# ---------------------------------------------------------------------------
# One of: anthropic | openai | compatible | local | none
AI_PROVIDER=none
AI_MODEL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2000
# Hard monthly ceiling in USD for AI spend. 0 disables the ceiling.
AI_MONTHLY_BUDGET_USD=25
# Only leads scoring at or above this value are sent to the model.
AI_MIN_LEAD_SCORE=65

# Anthropic (https://console.anthropic.com/)  — PAID
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI (https://platform.openai.com/) — PAID
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Any OpenAI-compatible endpoint (OpenRouter, Together, a local gateway…) — PAID/FREE
COMPATIBLE_AI_API_KEY=
COMPATIBLE_AI_BASE_URL=
COMPATIBLE_AI_MODEL=

# Local model server, e.g. Ollama (http://localhost:11434/v1) — FREE
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=

# ---------------------------------------------------------------------------
# OPTIONAL — Lead sources
# ---------------------------------------------------------------------------
# Google Places API (official, PAID, quota-limited).
# https://developers.google.com/maps/documentation/places/web-service/overview
# Leave empty: the platform uses OpenStreetMap and CSV import instead.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_LANGUAGE=fa
GOOGLE_PLACES_REGION=ir

# OpenStreetMap Overpass API — FREE, no key, ODbL licensed.
# Attribution is required when displaying the data: "© OpenStreetMap contributors".
OVERPASS_ENABLED=true
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# OPTIONAL — Search providers (used for website discovery)
# ---------------------------------------------------------------------------
# Brave Search API — FREEMIUM. https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Google Programmable Search JSON API — FREEMIUM (100 queries/day free).
# https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Domain-probe fallback: guesses <business>.ir / .com and verifies over HTTP.
# Results are always stored as NOT_VERIFIED until a human confirms them.
DOMAIN_PROBE_ENABLED=true

# ---------------------------------------------------------------------------
# OPTIONAL — Market intelligence: Google Ads
# Only reads data the authenticated account is permitted to access.
# https://developers.google.com/google-ads/api/docs/oauth/overview
# ---------------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v18

# ---------------------------------------------------------------------------
# OPTIONAL — Market intelligence: Google Search Console
# First-party data for Baimar-owned properties ONLY.
# https://developers.google.com/webmaster-tools/search-console-api-original
# ---------------------------------------------------------------------------
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
# e.g. https://baimar.ir/  or  sc-domain:baimar.ir
GSC_SITE_URL=

# ---------------------------------------------------------------------------
# OPTIONAL — Notifications
# ---------------------------------------------------------------------------
# Telegram bot: talk to @BotFather to create one. FREE.
TELEGRAM_BOT_TOKEN=
# Default chat/channel for team-wide alerts. Individual users can set their own.
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

# SMTP e-mail (optional).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Baimar <no-reply@baimar.ir>

# ---------------------------------------------------------------------------
# OPTIONAL — behaviour flags
# ---------------------------------------------------------------------------
# Seed 20 clearly-labelled demo businesses. Demo rows are always flagged
# `isDemo` and are hidden from production lists unless explicitly requested.
DEMO_MODE=false
LOG_LEVEL=info
# Trust X-Forwarded-* headers (set true when running behind Nginx).
TRUST_PROXY=false
