msgid "\"%1$s\" referenced a parent profile (\"%2$s\") that was not in the file, so it was imported as a root profile."
msgstr "«%1$s» به یک نمایه والد («%2$s») ارجاع می‌داد که در فایل نبود، بنابراین به‌عنوان نمایه ریشه درون‌ریزی شد."

msgid "\"%s\" is required."
msgstr "«%s» الزامی است."

msgid "%1$d conditions · %2$d actions"
msgstr "%1$d شرط · %2$d کنش"

msgid "%1$s (%2$s) — %3$d published"
msgstr "%1$s (%2$s) — %3$d منتشرشده"

msgid "%1$s (in %2$s on line %3$d)"
msgstr "%1$s (در %2$s، خط %3$d)"

msgid "%1$s answered HTTP %2$d in %3$s s. TLS verification succeeded."
msgstr "%1$s با HTTP %2$d در %3$s ثانیه پاسخ داد. بررسی گواهی TLS موفق بود."

msgid "%1$s is unreachable: %2$s"
msgstr "%1$s در دسترس نیست: %2$s"

msgid "%1$s resolves to %2$s."
msgstr "%1$s به %2$s تفکیک می‌شود."

msgid "%1$s یک فیلد را چاپ می‌کند. %2$s فقط وقتی بلوکش را نگه می‌دارد که فیلد مقدار داشته باشد و %3$s برعکس آن است. خطی که همه جایگزین‌هایش خالی درآمده باشد حذف می‌شود."
msgstr "%1$s یک فیلد را چاپ می‌کند. %2$s فقط وقتی بلوکش را نگه می‌دارد که فیلد مقدار داشته باشد و %3$s برعکس آن است. خطی که همه جایگزین‌هایش خالی درآمده باشد حذف می‌شود."

msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

msgid "%d check failed. Fix it and run the diagnostics again."
msgstr "%d بررسی ناموفق بود. آن را برطرف کنید و دوباره عیب‌یابی را اجرا کنید."

msgid "%d checks failed. Fix them and run the diagnostics again."
msgstr "%d بررسی ناموفق بودند. آن‌ها را برطرف کنید و دوباره عیب‌یابی را اجرا کنید."

msgid "%d field"
msgstr "%d فیلد"

msgid "%d fields"
msgstr "%d فیلد"

msgid "%d problem"
msgstr "%d اشکال"

msgid "%d problems"
msgstr "%d اشکال"

msgid "%d queued events used up their attempts without completing and were retired."
msgstr "%d رویداد در صف، تلاش‌های خود را بدون تکمیل مصرف کردند و کنار گذاشته شدند."

msgid "%d seconds"
msgstr "%d ثانیه"

msgid "%s (copy)"
msgstr "%s (رونوشت)"

msgid "%s The endpoint works, but real advertisements would still not be published:"
msgstr "%s سرویس پاسخ می‌دهد، اما آگهی‌های واقعی باز هم منتشر نمی‌شوند:"

msgid "%s could not be resolved from this server. This is a DNS problem on the WordPress host."
msgstr "%s از این سرور قابل تفکیک نبود. این یک مشکل DNS روی میزبان وردپرس است."

msgid "%s log entries found."
msgstr "%s گزارش یافت شد."

msgid "%s log entry found."
msgstr "%s گزارش یافت شد."

msgid "%s — deepest term"
msgstr "%s — عمیق‌ترین دسته"

msgid "%s — full path"
msgstr "%s — مسیر کامل"

msgid "%s — top level"
msgstr "%s — سطح نخست"

msgid "&laquo;"
msgstr "&laquo;"

msgid "&raquo;"
msgstr "&raquo;"

msgid "(none)"
msgstr "(هیچ‌کدام)"

msgid ", and "
msgstr "، و "

msgid "A condition reads the field \"%1$s\", which was not discovered on \"%2$s\". It will be read straight from post meta instead."
msgstr "یک شرط فیلد «%1$s» را می‌خواند که روی «%2$s» شناسایی نشده است. در عوض مستقیماً از متای نوشته خوانده می‌شود."

msgid "A delayed advertisement is rebuilt when it is finally sent, so an edit during the wait goes out corrected and a deletion cancels it."
msgstr "آگهی تأخیری هنگام ارسال نهایی دوباره ساخته می‌شود، بنابراین ویرایش در طول انتظار اصلاح‌شده ارسال می‌شود و حذف، ارسال را لغو می‌کند."

msgid "A deletion event was already emitted for this post."
msgstr "پیش‌تر برای این نوشته رویداد حذف ساخته شده است."

msgid "A destination is one place an advertisement is published. Several destinations may share a provider — five Telegram channels are five destinations — and each carries its own template, image limit and delay."
msgstr "مقصد یعنی یک جایی که آگهی در آن منتشر می‌شود. چند مقصد می‌توانند یک تأمین‌کننده مشترک داشته باشند — پنج کانال تلگرام یعنی پنج مقصد — و هرکدام الگو، سقف تصویر و تأخیر خودش را دارد."

msgid "A filter callback suppressed the detected event."
msgstr "یک فیلتر، رویداد شناسایی‌شده را متوقف کرد."

msgid "A number"
msgstr "یک عدد"

msgid "A plugin file is missing. Re-install the plugin to restore it."
msgstr "یکی از فایل‌های افزونه موجود نیست. برای بازیابی، افزونه را دوباره نصب کنید."

msgid "A profile is one complete publishing configuration: which fields are sent, under what labels and in what order, rendered by which template, with which images, to which destinations. Assign a profile to a post type or a category; anything below it inherits until you say otherwise."
msgstr "نمایه یعنی یک پیکربندی کامل انتشار: کدام فیلدها، با چه برچسبی، به چه ترتیب نمایشی، با کدام الگو، با کدام تصاویر و به کدام مقصدها ارسال شوند. یک نمایه را به نوع نوشته یا دسته اختصاص دهید؛ هرچه زیر آن است تا وقتی خلافش را نگویید ارث می‌برد."

msgid "A queued event was picked up from the queue for delivery (attempt %d)."
msgstr "یک رویداد از صف برای ارسال برداشته شد (تلاش %d)."

msgid "A rule stopped this advertisement from being published."
msgstr "یک قاعده مانع انتشار این آگهی شد."

msgid "A rule with no conditions applies to every advertisement."
msgstr "قاعده‌ای که شرطی ندارد بر همه آگهی‌ها اعمال می‌شود."

msgid "A secret is configured but it is shorter than 16 characters."
msgstr "کلید امنیتی تنظیم شده اما کمتر از ۱۶ نویسه است."

msgid "A secret is configured. Authentication style: %s. The value is never displayed or logged."
msgstr "کلید امنیتی تنظیم شده است. شیوه احراز هویت: %s. مقدار آن هرگز نمایش داده یا ثبت نمی‌شود."

msgid "A service that is not listed is one adapter class away: implement the DeliveryProvider interface and register it with %s. The settings form on this screen is built from the provider’s own schema, so no admin code is needed."
msgstr "سرویسی که در این فهرست نیست تنها یک کلاس آداپتور فاصله دارد: رابط DeliveryProvider را پیاده‌سازی کنید و آن را با %s ثبت کنید. فرم تنظیمات این صفحه از شمای خودِ تأمین‌کننده ساخته می‌شود، پس هیچ کد داشبوردی لازم نیست."

msgid "A wpep_is_eligible filter callback rejected the post."
msgstr "یک فیلتر wpep_is_eligible این نوشته را رد کرد."

msgid "AJAX پیشخوان"
msgstr "AJAX پیشخوان"

msgid "AND"
msgstr "و"

msgid "API key only (X-API-Key, X-Webhook-Secret)"
msgstr "فقط کلید API (هدرهای X-API-Key و X-Webhook-Secret)"

msgid "Accepted (HTTP %d)."
msgstr "پذیرفته شد (HTTP %d)."

msgid "Actions"
msgstr "عملیات"

msgid "Active"
msgstr "فعال"

msgid "Add action"
msgstr "افزودن کنش"

msgid "Add condition"
msgstr "افزودن شرط"

msgid "Add nested group"
msgstr "افزودن گروه تودرتو"

msgid "Add text after the message"
msgstr "افزودن متن پس از پیام"

msgid "Add text before the message"
msgstr "افزودن متن پیش از پیام"

msgid "Admin Dashboard — status, settings, logs and diagnostic tools."
msgstr "پیشخوان مدیریت — وضعیت، تنظیمات، گزارش‌ها و ابزارهای عیب‌یابی."

msgid "Admin Language"
msgstr "زبان داشبورد افزونه"

msgid "Advanced Custom Fields"
msgstr "Advanced Custom Fields"

msgid "Advertisement ID"
msgstr "شناسه آگهی"

msgid "Advertisement fields"
msgstr "فیلدهای آگهی"

msgid "Advertisement post ID"
msgstr "شناسه نوشته آگهی"

msgid "Advertisement post types"
msgstr "نوع‌های نوشته آگهی"

msgid "Advertisements published before this upgrade are now treated as back catalogue: editing one no longer announces it as new. Use Tools → Send One Advertisement Now to send an older advertisement deliberately."
msgstr "آگهی‌هایی که پیش از این به‌روزرسانی منتشر شده‌اند از این پس آرشیو قدیمی به شمار می‌آیند: ویرایش آن‌ها دیگر آن‌ها را به‌عنوان آگهی تازه اعلام نمی‌کند. برای ارسال عمدی یک آگهی قدیمی از ابزارها ← ارسال فوری یک آگهی استفاده کنید."

msgid "After 30 minutes"
msgstr "پس از ۳۰ دقیقه"

msgid "After 5 minutes"
msgstr "پس از ۵ دقیقه"

msgid "After an hour"
msgstr "پس از یک ساعت"

msgid "All"
msgstr "همه"

msgid "All %1$d publishing hooks are attached. %2$s"
msgstr "هر %1$d قلاب انتشار متصل هستند. %2$s"

msgid "All (post type default)"
msgstr "همه (پیش‌فرض نوع نوشته)"

msgid "All conditions must hold (AND)"
msgstr "همه شرط‌ها باید برقرار باشند (و)"

msgid "All event types"
msgstr "همه انواع رویداد"

msgid "All images (featured first, then gallery)"
msgstr "همه تصاویر (نخست تصویر شاخص، سپس گالری)"

msgid "All logs deleted."
msgstr "همه گزارش‌ها حذف شدند."

msgid "All of the below (recommended)"
msgstr "همه موارد زیر (پیشنهاد می‌شود)"

msgid "All statuses"
msgstr "همه وضعیت‌ها"

msgid "Allow outgoing webhook requests. Disable to pause delivery without losing configuration."
msgstr "اجازه ارسال درخواست‌های وب‌هوک. برای توقف موقت ارسال بدون از دست رفتن تنظیمات، آن را خاموش کنید."

msgid "Also send to"
msgstr "همچنین ارسال به"

msgid "Always after"
msgstr "همیشه پس از"

msgid "Always before"
msgstr "همیشه پیش از"

msgid "An exception interrupted the delivery: %s"
msgstr "یک استثنا ارسال را قطع کرد: %s"

msgid "An identical event for this post was already created moments ago; the duplicate was dropped."
msgstr "لحظه‌ای پیش رویداد یکسانی برای این نوشته ساخته شده بود؛ رویداد تکراری حذف شد."

msgid "Another plugin shortened this request to %1$d s despite the configured %2$d s; that is the cause, not the endpoint."
msgstr "افزونه دیگری مهلت این درخواست را به %1$d ثانیه کاهش داده است، در حالی که تنظیم شما %2$d ثانیه است؛ علت همین است، نه سرویس مقصد."

msgid "Another plugin tried to shorten this request to %1$d s; it was restored to %2$d s."
msgstr "افزونه دیگری تلاش کرد مهلت این درخواست را به %1$d ثانیه کاهش دهد؛ مقدار به %2$d ثانیه بازگردانده شد."

msgid "Another process is already delivering this attempt; skipping."
msgstr "پردازش دیگری همین تلاش را در دست دارد؛ از این اجرا صرف‌نظر شد."

msgid "Any condition is enough (OR)"
msgstr "هر شرطی کافی است (یا)"

msgid "Any term in a taxonomy"
msgstr "هر دسته در یک طبقه‌بندی"

msgid "Architecture"
msgstr "معماری"

msgid "Assigned term (deepest)"
msgstr "دسته اختصاص‌یافته (عمیق‌ترین)"

msgid "Assignment removed; this scope inherits again."
msgstr "اختصاص حذف شد؛ این دامنه دوباره ارث می‌برد."

msgid "Assignments"
msgstr "اختصاص‌ها"

msgid "Attempt %1$d failed; retrying in %2$d seconds. %3$s"
msgstr "تلاش %1$d ناموفق بود؛ تلاش بعدی %2$d ثانیه دیگر. %3$s"

msgid "Authenticated webhook request"
msgstr "درخواست وب‌هوک با احراز هویت"

msgid "Authentication failed: the service rejected the webhook secret. Check that the secret in Settings matches the one the Node.js service expects. This is not retried, because repeating it cannot help."
msgstr "احراز هویت ناموفق بود: سرویس کلید امنیتی وب‌هوک را نپذیرفت. بررسی کنید کلید موجود در تنظیمات با کلید مورد انتظار سرویس Node.js یکسان باشد. این خطا تکرار نمی‌شود، چون تکرار کمکی نمی‌کند."

msgid "Authentication style"
msgstr "شیوه احراز هویت"

msgid "Author"
msgstr "نویسنده"

msgid "Author (login)"
msgstr "نویسنده (نام کاربری)"

msgid "Author role"
msgstr "نقش نویسنده"

msgid "Automatic detection watches whatever is registered, whichever plugin created it (JetEngine, ACF, CPT UI, WooCommerce or a theme), so a post type added later is picked up without visiting this screen."
msgstr "تشخیص خودکار هر چه را که ثبت شده باشد پایش می‌کند، فرقی نمی‌کند کدام افزونه آن را ساخته باشد (JetEngine، ACF، CPT UI، ووکامرس یا قالب)، بنابراین نوع نوشته‌ای که بعداً اضافه شود بدون مراجعه به این صفحه شناسایی می‌شود."

msgid "Automatic — WP-Cron, with inline delivery when cron is unavailable (recommended)"
msgstr "خودکار — ارسال در همان درخواست، با WP-Cron به عنوان پشتیبان (پیشنهاد می‌شود)"

msgid "Automatic — every public post type, plus the ones ticked below"
msgstr "خودکار — همه نوع‌های نوشته عمومی، به‌علاوه موارد تیک‌خورده پایین"

msgid "Automatic — excerpt when present, otherwise the content"
msgstr "خودکار — چکیده در صورت وجود، در غیر این صورت متن نوشته"

msgid "Available providers"
msgstr "تأمین‌کننده‌های در دسترس"

msgid "Bearer token only (Authorization header)"
msgstr "فقط توکن Bearer (هدر Authorization)"

msgid "Block Kit card"
msgstr "کارت Block Kit"

msgid "Bootstrap — wp-event-publisher.php wires the autoloader and boots the container."
msgstr "راه‌اندازی — فایل wp-event-publisher.php بارگذار خودکار را وصل و ظرف سرویس‌ها را اجرا می‌کند."

msgid "Bot identifier"
msgstr "شناسه ربات"

msgid "Budget for establishing the connection alone (DNS and TLS). It is part of the total timeout above, and it makes an unreachable host fail quickly and recognisably instead of consuming the whole window."
msgstr "مهلت مربوط به برقراری خود اتصال (DNS و TLS). این مقدار بخشی از مهلت کل بالاست و باعث می‌شود میزبان در دسترس‌نبودن سریع و با پیام روشن شکست بخورد، به‌جای اینکه تمام مهلت را مصرف کند."

msgid "Builds the exact payload a publish would produce for one post ID and sends it immediately, so you can see the HTTP result without waiting for the queue."
msgstr "برای یک شناسه نوشته، دقیقاً همان داده‌ای را که انتشار واقعی می‌ساخت می‌سازد و فوری می‌فرستد تا نتیجه HTTP را بدون انتظار برای صف ببینید."

msgid "Bullet list"
msgstr "فهرست گلوله‌ای"

msgid "Buttons"
msgstr "دکمه‌ها"

msgid "Category"
msgstr "دسته"

msgid "Category (top level)"
msgstr "دسته (سطح نخست)"

msgid "Channel"
msgstr "کانال"

msgid "Channel Settings → Integrations → Webhooks → Copy Webhook URL."
msgstr "تنظیمات کانال ← یکپارچه‌سازی‌ها ← وب‌هوک‌ها ← رونوشت نشانی وب‌هوک."

msgid "Check"
msgstr "بررسی"

msgid "Checks the current settings for the problems that silently stop delivery: missing URL, weak secret, disabled toggles, empty post type selection and unusable cron settings."
msgstr "تنظیمات کنونی را برای اشکال‌هایی که بی‌صدا جلوی ارسال را می‌گیرند بررسی می‌کند: نبودن آدرس، کلید ضعیف، گزینه‌های خاموش، انتخاب نشدن نوع نوشته و تنظیمات کرون غیرقابل استفاده."

msgid "Clear Logs"
msgstr "پاک کردن همه گزارش‌ها"

msgid "Collapse or expand this group"
msgstr "جمع یا باز کردن این گروه"

msgid "Conditions"
msgstr "شرط‌ها"

msgid "Configuration looks valid. You are ready to publish advertisements."
msgstr "تنظیمات درست است. می‌توانید آگهی منتشر کنید."

msgid "Configured (never displayed or logged)"
msgstr "تنظیم شده (هرگز نمایش داده یا ثبت نمی‌شود)"

msgid "Connection Test"
msgstr "آزمایش اتصال"

msgid "Connection Timeout"
msgstr "مهلت برقراری اتصال"

msgid "Connection timeout: the request ran out of time before the service answered. Raise the Webhook Timeout, or check whether another plugin is shortening outgoing requests. The event stays in the queue and is retried."
msgstr "مهلت اتصال تمام شد: درخواست پیش از پاسخ سرویس به پایان مهلت رسید. مقدار «مهلت زمانی وب‌هوک» را بالا ببرید یا بررسی کنید افزونه دیگری مهلت درخواست‌های خروجی را کوتاه نکرده باشد. رویداد در صف می‌ماند و دوباره تلاش می‌شود."

msgid "Content (raw)"
msgstr "محتوا (خام)"

msgid "Continue processing rules"
msgstr "ادامه پردازش قواعد"

msgid "Contract version"
msgstr "نسخه قرارداد داده"

msgid "Contract — maps that data onto the versioned JSON envelope."
msgstr "قرارداد داده — آن داده را به ساختار JSON نسخه‌دار نگاشت می‌کند."

msgid "Create Destination"
msgstr "ساخت مقصد"

msgid "Create Profile"
msgstr "ساخت نمایه"

msgid "Create Rule"
msgstr "ساخت قاعده"

msgid "Create an incoming webhook in your Slack app and paste its URL here."
msgstr "در برنامه Slack خود یک وب‌هوک ورودی بسازید و نشانی آن را اینجا بچسبانید."

msgid "Credits"
msgstr "سپاسگزاری"

msgid "Currently retrying"
msgstr "در حال تلاش دوباره"

msgid "Custom delay in seconds"
msgstr "تأخیر دلخواه بر حسب ثانیه"

msgid "Custom field (number)"
msgstr "فیلد سفارشی (عدد)"

msgid "Custom field (text)"
msgstr "فیلد سفارشی (متن)"

msgid "Custom field (yes/no)"
msgstr "فیلد سفارشی (بله/خیر)"

msgid "Custom fields (post meta)"
msgstr "فیلدهای سفارشی (متای نوشته)"

msgid "DISABLE_WP_CRON is defined. Delivery does not depend on it: events are sent at the end of the publish request and the queue sweeper catches the rest."
msgstr "ثابت DISABLE_WP_CRON تعریف شده است. ارسال به آن وابسته نیست: رویدادها در پایان همان درخواست انتشار فرستاده می‌شوند و بازبین صف بقیه را می‌گیرد."

msgid "DNS resolution"
msgstr "تفکیک نام دامنه (DNS)"

msgid "Date (UTC)"
msgstr "تاریخ (UTC)"

msgid "Day of the week"
msgstr "روز هفته"

msgid "Debug Mode"
msgstr "حالت اشکال‌زدایی"

msgid "Default profile"
msgstr "نمایه پیش‌فرض"

msgid "Delay"
msgstr "تأخیر"

msgid "Delay publishing by N seconds"
msgstr "تأخیر انتشار به اندازه N ثانیه"

msgid "Delete"
msgstr "حذف"

msgid "Delete ALL log entries? This cannot be undone."
msgstr "همه گزارش‌ها حذف شوند؟ این کار بازگشت‌پذیر نیست."

msgid "Delete this log entry?"
msgstr "این گزارش حذف شود؟"

msgid "Delete this permanently?"
msgstr "این مورد برای همیشه حذف شود؟"

msgid "Deleted."
msgstr "حذف شد."

msgid "Delivered (kept for the duplicate guard)"
msgstr "ارسال‌شده (برای جلوگیری از تکرار نگه داشته می‌شود)"

msgid "Delivered: %1$d. Failed: %2$d."
msgstr "ارسال‌شده: %1$d. ناموفق: %2$d."

msgid "Delivering inline at the end of this request; the scheduled cron job remains as a backstop."
