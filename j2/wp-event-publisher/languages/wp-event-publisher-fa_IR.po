msgstr "الگوریتم امضا"

msgid "Signature tolerance"
msgstr "بازه مجاز زمانی امضا"

msgid "Signer — computes the HMAC-SHA256 signature over the raw request body."
msgstr "امضاکننده — امضای HMAC-SHA256 را روی بدنه خام درخواست محاسبه می‌کند."

msgid "Site ID"
msgstr "شناسه سایت"

msgid "Slack"
msgstr "Slack"

msgid "Slack webhook URL"
msgstr "نشانی وب‌هوک Slack"

msgid "Slug"
msgstr "نامک"

msgid "Stage"
msgstr "مرحله"

msgid "Stage, e.g. webhook.response"
msgstr "مرحله، مثلاً webhook.response"

msgid "Status"
msgstr "وضعیت"

msgid "Status \"%1$s\" is not one of the enabled publish statuses (%2$s)."
msgstr "وضعیت «%1$s» در فهرست وضعیت‌های مجاز انتشار (%2$s) نیست."

msgid "Stop processing further rules"
msgstr "توقف پردازش قواعد بعدی"

msgid "Subcategory"
msgstr "زیردسته"

msgid "Subject"
msgstr "موضوع"

msgid "System Information"
msgstr "اطلاعات سیستم"

msgid "Tags"
msgstr "برچسب‌ها"

msgid "Taxonomies"
msgstr "طبقه‌بندی‌ها"

msgid "Telegram Publisher"
msgstr "Telegram Publisher"

msgid "Telegram Publisher (Node.js webhook)"
msgstr "Telegram Publisher (وب‌هوک Node.js)"

msgid "Template text with {{placeholders}}"
msgstr "متن الگو با ‎{{جانگهدارها}}‎"

msgid "Test Rules"
msgstr "آزمایش قواعد"

msgid "Testing connection…"
msgstr "در حال آزمایش اتصال…"

msgid "Testing…"
msgstr "در حال آزمایش…"

msgid "Text"
msgstr "متن"

msgid "Text, for example a ⭐ badge"
msgstr "متن، برای نمونه یک نشان ⭐"

msgid "That advertisement does not exist."
msgstr "چنین آگهی‌ای وجود ندارد."

msgid "That delivery provider is not registered."
msgstr "آن تأمین‌کننده ارسال ثبت نشده است."

msgid "That delivery provider is not registered. If it came from another plugin, activate that plugin first."
msgstr "آن تأمین‌کننده ارسال ثبت نشده است. اگر از افزونه دیگری می‌آید، نخست آن افزونه را فعال کنید."

msgid "That destination could not be deleted."
msgstr "آن مقصد حذف نشد."

msgid "That destination could not be duplicated."
msgstr "آن مقصد تکثیر نشد."

msgid "That destination does not exist."
msgstr "چنین مقصدی وجود ندارد."

msgid "That does not look like a Discord webhook URL. It should start with https://discord.com/api/webhooks/."
msgstr "این نشانی شبیه وب‌هوک Discord نیست. باید با https://discord.com/api/webhooks/ آغاز شود."

msgid "That file is neither a profile export nor a rule export."
msgstr "آن فایل نه برون‌ریزی نمایه است و نه برون‌ریزی قاعده."

msgid "That is not a scope this site has."
msgstr "این دامنه‌ای نیست که این سایت داشته باشد."

msgid "That is not valid JSON."
msgstr "این JSON معتبر نیست."

msgid "That looks like a Telegram bot token. Bot tokens belong in the Node.js service, never in WordPress. Use a short name here instead."
msgstr "این شبیه توکن ربات تلگرام است. توکن ربات جایش در سرویس Node.js است، نه در وردپرس. اینجا به‌جای آن یک نام کوتاه بگذارید."

msgid "That parent would create a circular inheritance chain: the profile would end up inheriting from itself."
msgstr "آن والد یک زنجیره ارث‌بری حلقوی می‌سازد: نمایه در نهایت از خودش ارث می‌برد."

msgid "That profile could not be deleted. The default profile is protected."
msgstr "آن نمایه حذف نشد. نمایه پیش‌فرض محافظت‌شده است."

msgid "That profile could not be duplicated."
msgstr "آن نمایه تکثیر نشد."

msgid "That rule could not be deleted."
msgstr "آن قاعده حذف نشد."

msgid "The API secret is empty, so the request carries no authentication."
msgstr "کلید امنیتی خالی است، بنابراین درخواست هیچ احراز هویتی همراه ندارد."

msgid "The API secret is shorter than 16 characters. Use a long random token."
msgstr "کلید امنیتی کمتر از ۱۶ نویسه است. از یک رشته تصادفی بلند استفاده کنید."

msgid "The Discord webhook URL must be an absolute HTTPS address."
msgstr "نشانی وب‌هوک Discord باید یک نشانی HTTPS مطلق باشد."

msgid "The Slack webhook URL must be an absolute HTTPS address."
msgstr "نشانی وب‌هوک Slack باید یک نشانی HTTPS مطلق باشد."

msgid "The TLS handshake failed: the certificate could not be verified from this server. Check the certificate chain and the WordPress CA bundle. The event stays in the queue and is retried."
msgstr "دست‌دادن TLS ناموفق بود: گواهی از این سرور تأیید نشد. زنجیره گواهی و مجموعه گواهی‌های وردپرس را بررسی کنید. رویداد در صف می‌ماند و دوباره تلاش می‌شود."

msgid "The advertisement no longer exists, so its delayed delivery was dropped."
msgstr "آگهی دیگر وجود ندارد، بنابراین ارسال تأخیری آن رها شد."

msgid "The conditions did not match this advertisement."
msgstr "شرط‌ها با این آگهی تطبیق نیافتند."

msgid "The conditions matched."
msgstr "شرط‌ها تطبیق یافتند."

msgid "The configuration has problems that stop advertisements from being published:"
msgstr "تنظیمات اشکال‌هایی دارد که جلوی انتشار آگهی‌ها را می‌گیرد:"

msgid "The configured URL was rejected. Only HTTPS URLs are accepted, and link-local addresses are refused."
msgstr "آدرس تنظیم‌شده پذیرفته نشد. تنها آدرس‌های HTTPS مجاز هستند و آدرس‌های محلی شبکه رد می‌شوند."

msgid "The connection was refused or reset, usually a firewall on the WordPress host or the service not listening. The event stays in the queue and is retried."
msgstr "اتصال رد یا قطع شد؛ معمولاً به دلیل فایروال روی میزبان وردپرس یا خاموش بودن سرویس. رویداد در صف می‌ماند و دوباره تلاش می‌شود."

msgid "The delivery failed for an unrecognised reason. The exact transport message is stored with this log entry."
msgstr "ارسال به دلیلی ناشناخته ناموفق بود. پیام دقیق لایه انتقال همراه این گزارش ذخیره شده است."

msgid "The delivery provider \"%s\" is not registered, so this destination was skipped."
msgstr "تأمین‌کننده ارسال «%s» ثبت نشده است، بنابراین این مقصد نادیده گرفته شد."

msgid "The delivery provider raised an error: %s"
msgstr "تأمین‌کننده ارسال خطایی ایجاد کرد: %s"

msgid "The delivery queue now lives in its own database table instead of transients, which an object cache could evict. %d in-flight events were carried over."
msgstr "صف ارسال اکنون به‌جای transient در جدول اختصاصی خود در پایگاه داده نگه‌داری می‌شود، چون کش شیء می‌توانست transient را حذف کند. %d رویداد در جریان منتقل شدند."

msgid "The delivery used up its attempts without completing. This usually means building the payload killed the request — a fatal in a content filter, the memory limit, or the execution time limit. The event was retired so it cannot loop."
msgstr "این ارسال تلاش‌های خود را بدون تکمیل مصرف کرد. معمولاً یعنی ساخت داده ارسالی خودِ درخواست را از کار انداخته است — خطای مرگبار در یک فیلتر محتوا، محدودیت حافظه، یا محدودیت زمان اجرا. رویداد کنار گذاشته شد تا در حلقه نیفتد."

msgid "The description is sent as plain UTF-8 text, ready for a Telegram message. The untouched HTML is still available as post.content."
msgstr "توضیحات به صورت متن ساده UTF-8 و آماده برای پیام تلگرام فرستاده می‌شود. HTML دست‌نخورده همچنان در کلید post.content موجود است."

msgid "The destination \"%s\" is not configured. The advertisement will simply not be sent there."
msgstr "مقصد «%s» پیکربندی نشده است. آگهی صرفاً به آنجا فرستاده نمی‌شود."

msgid "The destination needs a name."
msgstr "مقصد به یک نام نیاز دارد."

msgid "The destination was not saved: fix these first, or save it disabled."
msgstr "مقصد ذخیره نشد: نخست این‌ها را برطرف کنید یا آن را غیرفعال ذخیره کنید."

msgid "The destination was removed or disabled before its delayed delivery ran."
msgstr "مقصد پیش از اجرای ارسال تأخیری‌اش حذف یا غیرفعال شد."

msgid "The endpoint URL is missing, is not HTTPS, or points at a private network address."
msgstr "نشانی نقطه پایانی موجود نیست، HTTPS نیست، یا به نشانی یک شبکه خصوصی اشاره می‌کند."

msgid "The endpoint accepted the payload (HTTP %1$d) in %2$s s."
msgstr "سرویس داده را پذیرفت (HTTP %1$d) در %2$s ثانیه."

msgid "The endpoint must be an absolute HTTPS address and must not point at a private network."
msgstr "نقطه پایانی باید یک نشانی HTTPS مطلق باشد و نباید به شبکه خصوصی اشاره کند."

msgid "The endpoint rejected the payload (HTTP %1$d): %2$s"
msgstr "سرویس داده را رد کرد (HTTP %1$d): %2$s"

msgid "The event reached a terminal state earlier; this duplicate run was ignored."
msgstr "این رویداد پیش‌تر به وضعیت نهایی رسیده بود؛ این اجرای تکراری نادیده گرفته شد."

msgid "The event type \"%1$s\" is disabled in Settings. Enabled types: %2$s."
msgstr "نوع رویداد «%1$s» در تنظیمات غیرفعال است. نوع‌های فعال: %2$s."

msgid "The export file contains no profiles."
msgstr "فایل برون‌ریزی هیچ نمایه‌ای ندارد."

msgid "The extra header must be written as \"Name: value\"."
msgstr "سرایند اضافی باید به شکل «نام: مقدار» نوشته شود."

msgid "The field \"%1$s\" no longer exists on the post type \"%2$s\". It is kept but will be ignored until the field comes back."
msgstr "فیلد «%1$s» دیگر روی نوع نوشته «%2$s» وجود ندارد. نگه داشته می‌شود اما تا بازگشت فیلد نادیده گرفته خواهد شد."

msgid "The message could not be encoded as JSON."
msgstr "پیام به JSON رمزگذاری نشد."

msgid "The message template could not be rendered, so a minimal message was sent instead: %s"
msgstr "الگوی پیام ساخته نشد، بنابراین به‌جای آن یک پیام کمینه ارسال شد: %s"

msgid "The parent profile \"%s\" does not exist."
msgstr "نمایه والد «%s» وجود ندارد."

msgid "The plugin is disabled in Settings (Enable Plugin is off)."
msgstr "افزونه در تنظیمات غیرفعال است (گزینه «فعال‌سازی افزونه» خاموش است)."

msgid "The plugin is disabled in Settings, so publishing an advertisement creates no event."
msgstr "افزونه در تنظیمات غیرفعال است، بنابراین انتشار آگهی هیچ رویدادی نمی‌سازد."

msgid "The plugin never talks to Telegram or any other social platform directly — all channel-specific logic lives in the Node.js service. WordPress stays responsible only for detecting events, collecting data, authenticating requests and logging."
msgstr "این افزونه هرگز به‌صورت مستقیم با تلگرام یا هیچ شبکه دیگری صحبت نمی‌کند؛ همه منطق مربوط به کانال در سرویس Node.js قرار دارد. وظیفه وردپرس تنها شناسایی رویداد، گردآوری داده، احراز هویت درخواست و ثبت گزارش است."

msgid "The post is a revision or an autosave."
msgstr "این نوشته یک نسخه بازبینی یا ذخیره خودکار است."

msgid "The post is gone or no longer published, so the event was dropped instead of delivered."
msgstr "نوشته وجود ندارد یا دیگر منتشرشده نیست، بنابراین رویداد به‌جای ارسال، دور ریخته شد."

msgid "The post is still an auto-draft."
msgstr "این نوشته هنوز پیش‌نویس خودکار است."

msgid "The post type \"%1$s\" is not enabled. Enabled post types: %2$s. Enable it under Settings → Allowed Post Types."
msgstr "نوع نوشته «%1$s» فعال نیست. نوع‌های فعال: %2$s. آن را در تنظیمات ← انواع نوشته مجاز فعال کنید."

msgid "The profile needs a name that produces a usable identifier."
msgstr "نمایه به نامی نیاز دارد که شناسه قابل استفاده‌ای بسازد."

msgid "The profile was not saved."
msgstr "نمایه ذخیره نشد."

msgid "The provider could not check its settings: %s"
msgstr "تأمین‌کننده نتوانست تنظیماتش را بررسی کند: %s"

msgid "The queue table is missing. Deactivate and reactivate the plugin to create it."
msgstr "جدول صف وجود ندارد. افزونه را غیرفعال و دوباره فعال کنید تا ساخته شود."

msgid "The request failed."
msgstr "درخواست ناموفق بود."

msgid "The request never completed (%1$s): %2$s — after %3$s s with a %4$d s timeout."
msgstr "درخواست هرگز کامل نشد (%1$s): %2$s — پس از %3$s ثانیه با مهلت %4$d ثانیه."

msgid "The request signature could not be verified."
msgstr "امضای درخواست تأیید نشد."

msgid "The request timestamp is outside the allowed tolerance window."
msgstr "زمان درخواست بیرون از بازه مجاز است."

msgid "The requested log action failed."
msgstr "عملیات درخواستی روی گزارش‌ها انجام نشد."

msgid "The rule \"%s\" stopped this advertisement from being published."
msgstr "قاعده «%s» مانع انتشار این آگهی شد."

msgid "The rule assigns the profile \"%s\", which does not exist."
msgstr "قاعده نمایه «%s» را اختصاص می‌دهد که وجود ندارد."

msgid "The rule could not be evaluated and was skipped: %s"
msgstr "قاعده ارزیابی نشد و نادیده گرفته شد: %s"

msgid "The rule has no actions, so matching it will not change anything."
msgstr "قاعده هیچ کنشی ندارد، بنابراین تطبیق آن چیزی را تغییر نمی‌دهد."

msgid "The rule has no conditions, so it applies to everything."
msgstr "قاعده هیچ شرطی ندارد، بنابراین بر همه‌چیز اعمال می‌شود."

msgid "The rule is disabled."
msgstr "قاعده غیرفعال است."

msgid "The rule needs a name that produces a usable identifier."
msgstr "قاعده به نامی نیاز دارد که شناسه قابل استفاده‌ای بسازد."

msgid "The rule sends to the destination \"%s\", which is not configured."
msgstr "قاعده به مقصد «%s» می‌فرستد که پیکربندی نشده است."

msgid "The rule was not saved."
msgstr "قاعده ذخیره نشد."

msgid "The rules now say this advertisement should not be published."
msgstr "قواعد اکنون می‌گویند این آگهی نباید منتشر شود."

msgid "The save did not change anything the payload exposes."
msgstr "این ذخیره هیچ‌یک از داده‌های ارسالی را تغییر نداد."

msgid "The save happened inside the post-publish cooldown window."
msgstr "این ذخیره در بازه آرامش پس از انتشار انجام شد."

msgid "The selected post type \"%s\" is not registered on this site. Check the slug."
msgstr "نوع نوشته انتخاب‌شده «%s» در این سایت ثبت نشده است. نامک را بررسی کنید."

msgid "The service answered with a server error (HTTP %d). It is usually restarting or overloaded; the event stays in the queue and is retried."
msgstr "سرویس با خطای سمت سرور پاسخ داد (HTTP %d). معمولاً در حال راه‌اندازی دوباره یا زیر بار است؛ رویداد در صف می‌ماند و دوباره تلاش می‌شود."

msgid "The service health probe at %1$s answered HTTP %2$d, so the host is reachable and the failure above is about the webhook request itself — check the secret and the response body."
msgstr "بررسی سلامت سرویس در %1$s پاسخ HTTP %2$d داد؛ پس میزبان در دسترس است و خطای بالا مربوط به خود درخواست وب‌هوک است — کلید امنیتی و بدنه پاسخ را بررسی کنید."

msgid "The service health probe at %1$s is also unreachable (%2$s), so this is a network or firewall problem on the WordPress side rather than a plugin setting."
msgstr "بررسی سلامت سرویس در %1$s هم در دسترس نیست (%2$s)؛ پس این یک مشکل شبکه یا فایروال در سمت وردپرس است، نه تنظیمات افزونه."

msgid "The service is rate limiting this site. The event stays in the queue and is retried later, honouring the Retry-After header when the service sends one."
msgstr "سرویس برای این سایت محدودیت نرخ اعمال کرده است. رویداد در صف می‌ماند و بعداً دوباره تلاش می‌شود؛ اگر سرویس هدر Retry-After بفرستد، همان رعایت می‌شود."

msgid "The service rejected the message (HTTP %d)."
msgstr "سرویس پیام را نپذیرفت (HTTP %d)."

msgid "The service rejected the payload itself (HTTP %d). The response body is stored with this log entry. This is not retried, because the same payload would be rejected again."
msgstr "سرویس خودِ داده ارسالی را رد کرد (HTTP %d). بدنه پاسخ همراه این گزارش ذخیره شده است. این خطا تکرار نمی‌شود، چون همان داده دوباره رد می‌شود."

msgid "The test could not be completed: %s"
msgstr "آزمایش کامل نشد: %s"

msgid "The webhook URL does not exist on that host, or the route does not accept POST. Check the Webhook URL setting. This is not retried."
msgstr "آدرس وب‌هوک روی آن میزبان وجود ندارد، یا آن مسیر درخواست POST نمی‌پذیرد. تنظیم «آدرس وب‌هوک» را بررسی کنید. این خطا تکرار نمی‌شود."

msgid "The webhook URL is empty."
msgstr "آدرس وب‌هوک خالی است."

msgid "The webhook URL is invalid. Only HTTPS URLs are accepted."
msgstr "آدرس وب‌هوک نامعتبر است. تنها آدرس‌های HTTPS پذیرفته می‌شوند."

msgid "The webhook URL must be an absolute HTTPS address and must not point at a private network."
msgstr "نشانی وب‌هوک باید یک نشانی HTTPS مطلق باشد و نباید به شبکه خصوصی اشاره کند."

msgid "The webhook URL was rejected: only valid HTTPS URLs are accepted."
msgstr "آدرس وب‌هوک پذیرفته نشد: تنها آدرس‌های HTTPS معتبر مجاز هستند."

msgid "The webhook host name could not be resolved from this server. Check DNS on the WordPress host. The event stays in the queue and is retried."
msgstr "نام میزبان وب‌هوک از این سرور قابل تفکیک نبود. تنظیمات DNS میزبان وردپرس را بررسی کنید. رویداد در صف می‌ماند و دوباره تلاش می‌شود."

msgid "The webhook timeout is only %d seconds. A TLS handshake to a remote server can take longer than that, which produces \"cURL error 28: Operation timed out\" even though the endpoint is healthy. Use 15 seconds."
msgstr "مهلت زمانی وب‌هوک تنها %d ثانیه است. دست‌دادن TLS با یک سرور دور می‌تواند بیشتر از این طول بکشد و همین باعث خطای «cURL error 28: Operation timed out» می‌شود، حتی وقتی سرویس سالم است. مقدار ۱۵ ثانیه را انتخاب کنید."

msgid "The webhook timeout was %d seconds, which is too short for a remote TLS handshake and produces spurious cURL error 28 failures. It has been raised to 15 seconds."
msgstr "مهلت زمانی وب‌هوک %d ثانیه بود که برای دست‌دادن TLS با سرور دور کوتاه است و خطاهای بی‌مورد cURL error 28 می‌سازد. این مقدار به ۱۵ ثانیه افزایش یافت."

msgid "There is no advertisement of this type to preview with. Publish one first."
msgstr "آگهی‌ای از این نوع برای پیش‌نمایش وجود ندارد. نخست یکی منتشر کنید."

msgid "There is no advertisement to test with. Publish one first."
msgstr "آگهی‌ای برای آزمایش وجود ندارد. نخست یکی منتشر کنید."

msgid "These hooks have no listener: %s. Another plugin may have removed them."
msgstr "این قلاب‌ها هیچ شنونده‌ای ندارند: %s. ممکن است افزونه دیگری آن‌ها را حذف کرده باشد."

msgid "These problems stop advertisements from reaching Telegram:"
msgstr "این اشکال‌ها مانع رسیدن آگهی‌ها به تلگرام می‌شوند:"

msgid "These totals count every advertisement this site has delivered, and they are kept independently of the queue, which only retains recent rows. The webhook secret is never shown here, in the logs, or in the page source."
