// Baimar Lead Intelligence — data model
//
// Design notes:
//  * Every externally-sourced fact keeps a reference to where it came from
//    (LeadSourceReference), so the UI can always answer "who says so?".
//  * Derived numbers (scores) are stored with their contributing reasons, never bare.
//  * Nullable is the default for anything a provider may not supply — the product rule is
//    "show Unknown", never "invent a value".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Enums
 */
/**
 * --------------------------------------------------------------------------
 */

enum Role {
  ADMIN
  SALES_MANAGER
  SALESPERSON
}

enum WebsiteStatus {
  UNKNOWN
  NO_WEBSITE
  NOT_VERIFIED
  ACTIVE
  PARKED
  BROKEN
  SOCIAL_ONLY
}

enum LeadTemperature {
  LOW
  MEDIUM
  WARM
  HOT
}

enum BusinessValueTier {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum ContactStatus {
  NEW
  RESEARCHED
  READY_TO_CALL
  CONTACTED
  NO_ANSWER
  CALLBACK
  INTERESTED
  MEETING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  NOT_INTERESTED
}

enum CampaignStatus {
  DRAFT
  READY
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

/// A run always reaches a terminal state. COMPLETED_WITH_ERRORS exists because
/// "finished, but three leads failed and two providers were down" is the honest
/// answer far more often than either COMPLETED or FAILED — and a run left sitting in
/// RUNNING forever is the failure mode this enum is shaped to prevent.
enum RunStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum ProviderKind {
  LEAD_SOURCE
  SEARCH
  BUSINESS_DATA
  WEBSITE
  AI
  KEYWORD_INSIGHT
  NOTIFICATION
}

/// Lifecycle of one integration, as shown in Settings → Integrations.
///
///   NOT_CONFIGURED  credentials are missing
///   DISABLED        an administrator switched it off
///   CONFIGURED      credentials present, never yet exercised
///   HEALTHY         a real call succeeded recently
///   DEGRADED        succeeding, but with failures or rate-limiting in the mix
///   ERROR           the last call failed
enum ProviderState {
  CONFIGURED
  NOT_CONFIGURED
  DISABLED
  HEALTHY
  DEGRADED
  ERROR
}

enum WebsiteFilter {
  ANY
  NO_WEBSITE
  HAS_WEBSITE
}

enum ActivityType {
  CALL
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
  EMAIL
  MEETING
  PROPOSAL_SENT
  FOLLOW_UP
  SYSTEM
}

enum CallOutcome {
  ANSWERED
  NO_ANSWER
  BUSY
  WRONG_NUMBER
  CALLBACK_REQUESTED
  NOT_INTERESTED
  INTERESTED
  MEETING_SET
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationEvent {
  HOT_LEAD
  LEAD_ASSIGNED
  FOLLOW_UP_DUE
  CAMPAIGN_COMPLETED
  AI_ANALYSIS_COMPLETED
  PROVIDER_FAILURE
  DAILY_SUMMARY
}

enum NotificationChannel {
  IN_APP
  TELEGRAM
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum MarketSignalStrength {
  INSUFFICIENT_DATA
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum KeywordSource {
  GOOGLE_ADS
  SEARCH_CONSOLE
  MANUAL_IMPORT
  SITE_ANALYTICS
  PROVIDER
}

enum DataOrigin {
  PUBLIC_BUSINESS_RESEARCH
  FIRST_PARTY_BAIMAR
  ADVERTISING_CAMPAIGN
  AGGREGATE_SEARCH_SIGNAL
  AI_INFERENCE
  MANUAL_ENTRY
}

/// The badge shown next to a market number. This is what stops the platform from
/// implying more than it knows:
///
///   FACT        measured directly from a first-party property
///   AGGREGATE   an aggregate signal over many people — never one identifiable person
///   ESTIMATED   derived or extrapolated by this system, and labelled as such
///   IMPORTED    supplied by a human via CSV; only as good as the sheet
///   AI_INSIGHT  a model's interpretation, never a measurement
///   UNKNOWN     no data — displayed as "unknown", never as zero
enum DataQuality {
  FACT
  AGGREGATE
  ESTIMATED
  IMPORTED
  AI_INSIGHT
  UNKNOWN
}

enum Confidence {
  FACT
  CALCULATED
  ESTIMATED
  AI_INSIGHT
  UNKNOWN
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Identity & access
 */
/**
 * --------------------------------------------------------------------------
 */

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           Role      @default(SALESPERSON)
  isActive       Boolean   @default(true)
  phone          String?
  telegramChatId String?
  locale         String    @default("fa")
  theme          String    @default("dark")
  lastLoginAt    DateTime?
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  refreshTokens RefreshToken[]
  assignedLeads Lead[]          @relation("LeadAssignee")
  createdLeads  Lead[]          @relation("LeadCreator")
  activities    SalesActivity[]
  calls         Call[]
  notes         Note[]
  tasksAssigned Task[]          @relation("TaskAssignee")
  tasksCreated  Task[]          @relation("TaskCreator")
  followUps     FollowUp[]
  campaigns     Campaign[]
  notifications Notification[]
  auditLogs     AuditLog[]
  importBatches ImportBatch[]

  @@index([role])
  @@index([isActive])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Leads
 */
/**
 * --------------------------------------------------------------------------
 */

model Lead {
  id                     String  @id @default(cuid())
  businessName           String
  normalizedBusinessName String
  /// Order-insensitive token key used for fuzzy deduplication.
  nameKey                String
  businessType           String?
  category               String?
  subcategory            String?

  country   String  @default("IR")
  province  String?
  city      String?
  area      String?
  address   String?
  latitude  Float?
  longitude Float?

  /// Exactly as the source provided it — never overwritten.
  originalPhone   String?
  /// E.164 canonical form, null when the number could not be understood.
  normalizedPhone String?
  mobile          String?
  extraPhones     String[] @default([])
  email           String?

  website          String?
  websiteStatus    WebsiteStatus @default(UNKNOWN)
  websiteDomain    String?
  websiteCheckedAt DateTime?
  /// How sure we are that this website belongs to *this* business (0-100).
  /// A website is never attached silently: below WEBSITE_MATCH_MIN_CONFIDENCE the
  /// candidate is stored as a suggestion for a human to confirm.
  websiteMatchConfidence Int?
  /// The individual signals behind that number (name match, phone match, city…),
  /// so a salesperson can see why we believe it.
  websiteMatchReasons    Json?
  /// Which provider produced the match: the lead source itself, a search engine…
  websiteMatchedBy       String?
  /// Last successful crawl. Drives the audit cache: a site is not refetched while a
  /// recent audit exists, unless the caller asks for a forced re-audit.
  lastCrawledAt          DateTime?

  googleMapsUrl String?
  instagramUrl  String?
  telegramUrl   String?
  linkedinUrl   String?
  whatsappUrl   String?
  facebookUrl   String?
  aparatUrl     String?

  description  String?
  services     String[] @default([])
  products     String[] @default([])
  openingHours Json?

  reviewCount  Int?
  reviewRating Float?

  businessSizeEstimate String?
  businessValueScore   Int?
  businessValueTier    BusinessValueTier @default(UNKNOWN)
  businessValueReasons Json?

  leadScore       Int?
  leadTemperature LeadTemperature?
  scoreBreakdown  Json?
  scoredAt        DateTime?

  recommendedService String?
  secondaryServices  String[] @default([])
  salesAngle         String?
  painPoints         String[] @default([])
  opportunities      String[] @default([])

  decisionMakerName String?
  decisionMakerRole String?

  contactStatus  ContactStatus @default(NEW)
  assignedToId   String?
  createdById    String?
  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  wonAt          DateTime?
  lostAt         DateTime?
  lostReason     String?

  campaignId String?
  /// Demo rows are always flagged and are excluded from production views by default.
  isDemo     Boolean @default(false)
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTo User?     @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?     @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  sourceReferences LeadSourceReference[]
  websiteAudits    WebsiteAudit[]
  socialSignals    SocialSignal[]
  businessSignals  BusinessSignal[]
  scores           LeadScore[]
  aiAnalyses       AIAnalysis[]
  salesBriefs      SalesBrief[]
  activities       SalesActivity[]
  calls            Call[]
  notes            Note[]
  tasks            Task[]
  followUps        FollowUp[]
  notifications    Notification[]
  opportunities_   Opportunity[]

  // Deduplication ladder — every lookup in core/dedupe.ts, in the order it tries them.
  @@index([normalizedPhone])
  @@index([websiteDomain])
  @@index([nameKey])
  @@index([city])
  @@index([province])
  @@index([category])
  @@index([leadScore])
  @@index([leadTemperature])
  @@index([contactStatus])
  @@index([assignedToId])
  @@index([campaignId])
  @@index([nextFollowUpAt])
  @@index([websiteStatus])
  @@index([isDemo])
  @@index([createdAt])
  /// The raw phone is searchable from the lead list ("who is this number?"),
  /// which the normalized index cannot serve because the user types what they see.
  @@index([originalPhone])

  // Compound indexes for the queries the application actually runs. Every list and
  // every analytic starts from the same visibility predicate — isArchived + isDemo —
  // so putting those columns first lets one index serve the whole family.
  /// Lead list and dashboard buckets: visible leads ordered by score.
  @@index([isArchived, isDemo, leadScore(sort: Desc)])
  /// Pipeline board and "hot leads to call": visible leads by temperature.
  @@index([isArchived, isDemo, leadTemperature, leadScore(sort: Desc)])
  /// A salesperson's own queue.
  @@index([isArchived, isDemo, assignedToId, contactStatus])
  /// Today view: due and overdue follow-ups, oldest first.
  @@index([isArchived, isDemo, nextFollowUpAt])
  /// City + service targeting from a market signal (patch 61).
  @@index([isArchived, isDemo, city, recommendedService])
  /// Acquisition reporting over a date range.
  @@index([isArchived, isDemo, createdAt])
  /// Campaign run accounting.
  @@index([campaignId, leadTemperature])
}

/// Catalogue of places leads can come from (one row per provider adapter, plus CSV/manual).
model LeadSource {
  id          String   @id @default(cuid())
  key         String   @unique
  displayName String
  kind        String
  description String?
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())

  references LeadSourceReference[]
}

/// A single observation of a business from one source. Multiple references collapse into
/// one Lead during deduplication, but each reference is retained for transparency.
model LeadSourceReference {
  id           String     @id @default(cuid())
  leadId       String
  leadSourceId String?
  providerKey  String
  externalId   String?
  sourceUrl    String?
  /// Which lead fields this source contributed, so the UI can attribute each value.
  fields       String[]   @default([])
  origin       DataOrigin @default(PUBLIC_BUSINESS_RESEARCH)
  confidence   Confidence @default(FACT)
  raw          Json?
  fetchedAt    DateTime   @default(now())

  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadSource LeadSource? @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)

  @@unique([providerKey, externalId, leadId])
  @@index([leadId])
  @@index([providerKey])
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Campaigns
 */
/**
 * --------------------------------------------------------------------------
 */

model Campaign {
  id            String         @id @default(cuid())
  name          String
  description   String?
  status        CampaignStatus @default(DRAFT)
  country       String         @default("IR")
  province      String?
  city          String?
  area          String?
  categories    String[]       @default([])
  keywords      String[]       @default([])
  providers     String[]       @default([])
  websiteFilter WebsiteFilter  @default(ANY)
  minLeadScore  Int?
  maxResults    Int            @default(200)
  /// When true the pipeline runs AI analysis on qualified leads (costs money).
  enableAi      Boolean        @default(true)
  /// Only leads at or above this score get AI analysis.
  aiMinScore    Int            @default(65)
  createdById   String?
  isDemo        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastRunAt     DateTime?

  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  runs      CampaignRun[]
  leads     Lead[]

  @@index([status])
  @@index([createdById])
}

model CampaignRun {
  id         String    @id @default(cuid())
  campaignId String
  status     RunStatus @default(QUEUED)
  stage      String?
  progress   Int       @default(0)

  /// Records returned by the providers, before deduplication.
  collected Int @default(0)
  /// Leads created by this run.
  unique    Int @default(0)
  /// Records that matched an existing lead and were merged into it.
  merged    Int @default(0)
  /// Records rejected before becoming a lead (unusable name, no contact route…).
  duplicates Int @default(0)
  qualified Int @default(0)
  hot       Int @default(0)
  warm      Int @default(0)
  medium    Int @default(0)
  low       Int @default(0)
  rejected  Int @default(0)
  /// Leads whose pipeline exhausted its retries. Counted, never silently dropped:
  /// every lead this run created is accounted for in exactly one of the buckets.
  failed    Int @default(0)
  errors    Int @default(0)
  /// Per-provider outcome for this run, surfaced in the campaign UI.
  providerResults Json?

  /// Per-stage log entries, appended as the pipeline advances.
  log        Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status])
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Website intelligence
 */
/**
 * --------------------------------------------------------------------------
 */

model WebsiteAudit {
  id            String   @id @default(cuid())
  leadId        String
  url           String
  finalUrl      String?
  reachable     Boolean  @default(false)
  httpStatus    Int?
  redirectChain String[] @default([])

  /// Raw observations. Kept so scores can be recomputed without re-crawling.
  raw Json

  seoScore           Int?
  mobileScore        Int?
  performanceScore   Int?
  uxScore            Int?
  conversionScore    Int?
  technicalScore     Int?
  accessibilityScore Int?
  overallScore       Int?

  /// Measurement names that could not be taken (shown as "unavailable", never as zero).
  unavailable  String[] @default([])
  findings     Json?
  technologies Json?

  pagesCrawled Int  @default(0)
  totalBytes   Int?
  responseMs   Int?

  hasSsl            Boolean?
  hasViewport       Boolean?
  hasContactForm    Boolean?
  hasContactPage    Boolean?
  hasAboutPage      Boolean?
  hasBlog           Boolean?
  hasEcommerce      Boolean?
  hasBooking        Boolean?
  hasAnalytics      Boolean?
  hasFavicon        Boolean?
  hasLogo           Boolean?
  hasSitemap        Boolean?
  hasRobots         Boolean?
  hasStructuredData Boolean?
  socialLinks       String[] @default([])
  discoveredPhones  String[] @default([])
  discoveredEmails  String[] @default([])

  error     String?
  createdAt DateTime @default(now())

  /// Version of the audit engine that produced this row. When the engine changes,
  /// an older audit is stale even if it is recent, and the cache must not serve it.
  engineVersion String @default("1")
  /// Hash of the crawled content. Identical content on a re-crawl means the scores
  /// cannot have changed, so the previous findings are reused.
  contentHash   String?
  /// Which audit layer produced this row: HTTP always, BROWSER only when enabled.
  method        String @default("HTTP")

  lead    Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  pages   WebsitePage[]
  browser BrowserAudit?

  @@index([leadId])
  @@index([createdAt])
  /// Audit cache lookup: the newest audit for one lead.
  @@index([leadId, createdAt(sort: Desc)])
  @@index([contentHash])
}

/// Real-browser measurements (patch 12).
///
/// Deliberately a separate table from WebsiteAudit, because the two answer different
/// questions and have different availability. The HTTP audit always runs; the browser
/// audit only runs when BROWSER_AUDIT_ENABLED is on and Playwright is installed. A
/// metric that was not measured is stored as NULL and rendered as "not available" —
/// never as zero, and never estimated from the HTTP audit.
model BrowserAudit {
  id      String @id @default(cuid())
  auditId String @unique
  leadId  String
  url     String

  status        String   @default("OK") /// OK | NOT_AVAILABLE | ERROR
  unavailableReason String?

  /// Core Web Vitals, as measured in this one synthetic run on this one machine.
  /// They are a laboratory signal, not field data from real users.
  lcpMs           Float?
  cls             Float?
  inpMs           Float?
  fcpMs           Float?
  ttfbMs          Float?
  domContentLoadedMs Float?
  loadEventMs        Float?

  viewportWidth   Int?
  viewportHeight  Int?
  /// True when the page fits the mobile viewport without horizontal scrolling.
  fitsMobileViewport Boolean?
  horizontalOverflowPx Int?
  /// Smallest font size found in rendered body text, in CSS pixels.
  smallestFontPx  Float?
  /// Tap targets smaller than the 44x44 CSS-pixel guidance.
  smallTapTargets Int?

  consoleErrors   Json?
  failedRequests  Json?
  requestCount    Int?
  transferredBytes Int?

  screenshotPath  String?
  browserName     String?
  browserVersion  String?
  durationMs      Int?
  createdAt       DateTime @default(now())

  audit WebsiteAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}

model WebsitePage {
  id               String   @id @default(cuid())
  auditId          String
  url              String
  httpStatus       Int?
  title            String?
  metaDescription  String?
  h1               String[] @default([])
  h2               String[] @default([])
  canonical        String?
  wordCount        Int?
  bytes            Int?
  responseMs       Int?
  hasForm          Boolean  @default(false)
  imageCount       Int      @default(0)
  imagesWithoutAlt Int      @default(0)
  internalLinks    Int      @default(0)
  externalLinks    Int      @default(0)
  role             String?
  fetchedAt        DateTime @default(now())

  audit WebsiteAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

model SocialSignal {
  id         String     @id @default(cuid())
  leadId     String
  platform   String
  handle     String?
  url        String
  /// Only publicly visible aggregate numbers, and only when the platform exposes them.
  followers  Int?
  postCount  Int?
  lastPostAt DateTime?
  isActive   Boolean?
  confidence Confidence @default(FACT)
  source     String?
  sourceUrl  String?
  observedAt DateTime   @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, platform, url])
  @@index([leadId])
}

/// A single boolean/measured fact about the business used by the scoring engine.
model BusinessSignal {
  id         String     @id @default(cuid())
  leadId     String
  key        String
  value      Boolean
  weightHint Int?
  evidence   String?
  confidence Confidence @default(CALCULATED)
  origin     DataOrigin @default(PUBLIC_BUSINESS_RESEARCH)
  sourceUrl  String?
  observedAt DateTime   @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, key])
  @@index([leadId])
  @@index([key])
}

/// Score history. The current value is denormalized onto Lead for fast filtering.
model LeadScore {
  id          String          @id @default(cuid())
  leadId      String
  score       Int
  temperature LeadTemperature
  breakdown   Json
  configHash  String?
  reason      String?
  createdAt   DateTime        @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * AI & sales enablement
 */
/**
 * --------------------------------------------------------------------------
 */

model AIAnalysis {
  id       String @id @default(cuid())
  leadId   String
  provider String
  model    String

  businessSummary       String?
  likelyCustomerProfile String?
  mainDigitalProblems   String[] @default([])
  businessOpportunities String[] @default([])
  recommendedService    String?
  secondaryServices     String[] @default([])
  salesAngle            String?
  whyContact            String?
  recommendedOpening    String?
  recommendedQuestions  String[] @default([])
  likelyObjections      String[] @default([])
  objectionStrategy     String?
  recommendedNextStep   String?

  /// Exactly what was sent to and returned by the model, for traceability.
  inputSnapshot Json?
  rawOutput     Json?
  /// Hash of the input snapshot: identical input is served from cache, never re-billed.
  inputHash     String?
  /// Prompt revision. A cache entry is only reused when the prompt version, the
  /// provider and the model all match — otherwise an edited prompt would be masked
  /// by a stale hit.
  promptVersion String @default("1")
  /// Set when the model's JSON failed schema validation and the deterministic brief
  /// was used instead. Kept so a bad prompt is visible rather than silently absorbed.
  validationError String?
  /// True when this row was produced by the rules engine after AI was unavailable,
  /// over budget, or invalid.
  usedFallback  Boolean @default(false)

  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  estimatedCostUsd Float?
  latencyMs        Int?
  error            String?
  createdAt        DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([inputHash])
  @@index([createdAt])
  /// Cache lookup: same lead, same input, same prompt, same model.
  @@index([leadId, inputHash, promptVersion, model])
}

model SalesBrief {
  id           String   @id @default(cuid())
  leadId       String
  /// RULES when produced without AI, AI when fully generated, HYBRID when merged.
  generatedBy  String   @default("RULES")
  content      Json
  aiAnalysisId String?
  version      Int      @default(1)
  isCurrent    Boolean  @default(true)
  createdAt    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([isCurrent])
}

model Service {
  id                 String   @id @default(cuid())
  key                String   @unique
  nameFa             String
  nameEn             String
  descriptionFa      String?
  basePriority       Int      @default(50)
  isActive           Boolean  @default(true)
  /// Deterministic rules evaluated by the opportunity engine.
  rules              Json
  salesAngles        String[] @default([])
  commonObjections   String[] @default([])
  objectionResponses String[] @default([])
  discoveryQuestions String[] @default([])
  /// Search terms that indicate demand for this service, in Persian or English.
  /// Editable in Settings → Services: adding a service to the catalogue must not
  /// require a code change for the market engine to start recognising its keywords.
  matchKeywords      String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  opportunities Opportunity[]
  keywords      KeywordService[]
  marketSignals MarketSignal[]
}

/// Result of matching a lead against a service, combining lead signals and market demand.
model Opportunity {
  id          String   @id @default(cuid())
  leadId      String
  serviceId   String
  serviceKey  String
  score       Int
  level       String
  reasons     String[] @default([])
  /// Per-factor breakdown of the score: which rule fired, the market boost, the
  /// business-value contribution, and the observation behind each one. Stored so the
  /// UI can justify a 94 rather than merely display it.
  factors     Json?
  marketBoost Int      @default(0)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([leadId, serviceId])
  @@index([leadId])
  @@index([serviceKey])
  @@index([score])
  /// Market signal -> call list: best-scoring opportunities for one service.
  @@index([serviceKey, score(sort: Desc)])
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * CRM
 */
/**
 * --------------------------------------------------------------------------
 */

model SalesActivity {
  id        String       @id @default(cuid())
  leadId    String
  userId    String?
  type      ActivityType
  title     String
  body      String?
  metadata  Json?
  createdAt DateTime     @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
  /// Lead timeline, newest first.
  @@index([leadId, createdAt(sort: Desc)])
  /// Activity report per salesperson over a period.
  @@index([userId, type, createdAt])
}

model Call {
  id              String      @id @default(cuid())
  leadId          String
  userId          String?
  phone           String?
  outcome         CallOutcome
  durationSeconds Int?
  notes           String?
  nextActionAt    DateTime?
  createdAt       DateTime    @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([createdAt])
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  userId    String?
  body      String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
}

model Task {
  id           String       @id @default(cuid())
  leadId       String?
  title        String
  description  String?
  status       TaskStatus   @default(OPEN)
  priority     TaskPriority @default(NORMAL)
  dueAt        DateTime?
  completedAt  DateTime?
  assignedToId String?
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  lead       Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueAt])
  /// The task list a salesperson opens every morning: mine, open, by due date.
  @@index([assignedToId, status, dueAt])
}

model FollowUp {
  id             String    @id @default(cuid())
  leadId         String
  userId         String?
  kind           String
  dueAt          DateTime
  completedAt    DateTime?
  notes          String?
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([dueAt])
  @@index([completedAt])
  /// Today / Overdue / Upcoming: open follow-ups for one user by due date.
  @@index([userId, completedAt, dueAt])
  /// The scheduler's sweep: everything still open and now due, across all users.
  @@index([completedAt, dueAt])
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Market & search intent intelligence
 */
/**
 * --------------------------------------------------------------------------
 */

/// A keyword we track. Metrics live on KeywordSignal so several sources can coexist.
model Keyword {
  id                String   @id @default(cuid())
  keyword           String
  normalizedKeyword String
  language          String?  @default("fa")
  isActive          Boolean  @default(true)
  /// Demo rows are excluded from the market dashboard unless explicitly requested.
  isDemo            Boolean  @default(false)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  signals   KeywordSignal[]
  trends    KeywordTrend[]
  locations KeywordLocation[]
  services  KeywordService[]

  @@unique([normalizedKeyword, language])
  @@index([normalizedKeyword])
}

/// One metric observation for a keyword, from one source, for one day/period.
/// Every metric is nullable: no provider supplies all of them.
model KeywordSignal {
  id         String        @id @default(cuid())
  keywordId  String
  source     KeywordSource
  sourceUrl  String?
  origin     DataOrigin    @default(AGGREGATE_SEARCH_SIGNAL)
  confidence Confidence    @default(FACT)

  city     String?
  province String?
  country  String? @default("IR")

  searchVolume     Int?
  competition      String?
  competitionIndex Int?
  trend            String?
  clicks           Int?
  impressions      Int?
  conversions      Float?
  costMicros       BigInt?
  ctr              Float?
  averagePosition  Float?

  date          DateTime?
  periodStart   DateTime?
  periodEnd     DateTime?
  importBatchId String?
  isDemo        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId])
  @@index([source])
  @@index([city])
  @@index([date])
  /// Market dashboard: signals for one keyword in one city over a period.
  /// KeywordSignal has no serviceKey of its own — the service link lives in
  /// KeywordService, so the join goes keyword -> service and filters here on city+date.
  @@index([keywordId, city, date])
  @@index([isDemo, date])
}

model KeywordTrend {
  id        String        @id @default(cuid())
  keywordId String
  period    String
  value     Float
  direction String?
  source    KeywordSource
  createdAt DateTime      @default(now())

  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, period, source])
  @@index([keywordId])
}

model KeywordLocation {
  id        String  @id @default(cuid())
  keywordId String
  city      String?
  province  String?
  country   String  @default("IR")

  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, city, province, country])
  @@index([city])
}

model KeywordService {
  id         String @id @default(cuid())
  keywordId  String
  serviceId  String
  serviceKey String
  weight     Float  @default(1)

  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([keywordId, serviceId])
  @@index([serviceKey])
}

/// Search terms that actually triggered Baimar's own ads, or that appear in
/// Search Console for Baimar's own properties. First-party / advertising data only.
model SearchTerm {
  id               String        @id @default(cuid())
  term             String
  normalizedTerm   String
  source           KeywordSource
  origin           DataOrigin    @default(ADVERTISING_CAMPAIGN)
  /// Where this observation can be traced back to — a Google Ads report, the import
  /// batch it arrived in. Provenance is mandatory on anything a salesperson may quote.
  sourceUrl        String?
  campaignName     String?
  adGroupName      String?
  matchType        String?
  city             String?
  province         String?
  country          String?       @default("IR")
  clicks           Int?
  impressions      Int?
  conversions      Float?
  costMicros       BigInt?
  ctr              Float?
  averagePosition  Float?
  averageCpcMicros BigInt?
  date             DateTime?
  periodStart      DateTime?
  periodEnd        DateTime?
  serviceKey       String?
  importBatchId    String?
  isDemo           Boolean       @default(false)
  createdAt        DateTime      @default(now())

  @@index([normalizedTerm])
  @@index([source])
  @@index([date])
  @@index([serviceKey])
  @@index([city])
  /// "Which services showed demand in this city last month?"
  @@index([serviceKey, city, date])
  @@index([isDemo, date])
}

/// Aggregated demand signal per service (and optionally per city) over a period.
/// This is what the Market Demand dashboard renders.
model MarketSignal {
  id         String  @id @default(cuid())
  serviceId  String?
  serviceKey String?
  city       String?
  province   String?
  country    String  @default("IR")

  strength   MarketSignalStrength @default(INSUFFICIENT_DATA)
  score      Float?
  basis      String
  confidence Confidence           @default(CALCULATED)
  sources    KeywordSource[]      @default([])
  sampleSize Int                  @default(0)

  /// Provenance is mandatory on a market signal, because a salesperson will repeat
  /// what it says on a phone call. `origin` records where the underlying observations
  /// came from; `quality` is the label the UI shows; `sourceUrls` lets anyone follow
  /// the claim back to its source.
  origin     DataOrigin  @default(AGGREGATE_SEARCH_SIGNAL)
  quality    DataQuality @default(AGGREGATE)
  sourceUrls String[]    @default([])
  /// Human-readable measurement period, e.g. "1 Aug – 31 Aug 2026".
  periodLabel String?

  totalClicks      Int?
  totalImpressions Int?
  totalConversions Float?
  totalCostMicros  BigInt?
  averageVolume    Float?

  periodStart DateTime?
  periodEnd   DateTime?
  isDemo      Boolean   @default(false)
  computedAt  DateTime  @default(now())

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@unique([serviceKey, city, periodStart, periodEnd])
  @@index([serviceKey])
  @@index([city])
  @@index([strength])
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Providers, jobs, settings, observability
 */
/**
 * --------------------------------------------------------------------------
 */

model Provider {
  id          String        @id @default(cuid())
  key         String        @unique
  kind        ProviderKind
  displayName String
  description String?
  enabled     Boolean       @default(false)
  state       ProviderState @default(NOT_CONFIGURED)
  /// Non-secret settings. Secrets are stored encrypted in `secrets` and never returned.
  config      Json?
  secrets     Json?
  priority    Int           @default(100)

  rateLimitPerMinute Int?
  rateLimitPerHour   Int?
  rateLimitPerDay    Int?

  lastError   String?
  lastErrorAt DateTime?
  lastUsedAt  DateTime?
  /// Last call that actually succeeded — the honest answer to "is this working?".
  lastSuccessAt DateTime?
  /// Last explicit health check run from the admin panel.
  lastCheckAt      DateTime?
  lastCheckOk      Boolean?
  lastCheckMessage String?
  /// Consecutive failures since the last success; drives CONFIGURED -> DEGRADED -> ERROR.
  consecutiveFailures Int @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  usage ProviderUsage[]

  @@index([kind])
  @@index([enabled])
}

/// Daily rollup of provider consumption, used by the cost dashboard.
model ProviderUsage {
  id               String       @id @default(cuid())
  providerId       String?
  providerKey      String
  kind             ProviderKind
  day              DateTime
  requests         Int          @default(0)
  failures         Int          @default(0)
  promptTokens     Int          @default(0)
  completionTokens Int          @default(0)
  totalTokens      Int          @default(0)
  estimatedCostUsd Float        @default(0)
  bytesFetched     BigInt       @default(0)
  updatedAt        DateTime     @updatedAt
  createdAt        DateTime     @default(now())

  provider Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@unique([providerKey, day])
  @@index([day])
  @@index([kind])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  leadId    String?
  event     NotificationEvent
  channel   NotificationChannel @default(IN_APP)
  status    NotificationStatus  @default(PENDING)
  title     String
  body      String?
  payload   Json?
  readAt    DateTime?
  sentAt    DateTime?
  error     String?
  createdAt DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([event])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  actorEmail String?
  action     String
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SystemSetting {
  key         String   @id
  value       Json
  description String?
  /// Secret settings are never included in API responses.
  isSecret    Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model ImportBatch {
  id            String       @id @default(cuid())
  kind          String
  filename      String?
  status        ImportStatus @default(PENDING)
  totalRows     Int          @default(0)
  importedRows  Int          @default(0)
  mergedRows    Int          @default(0)
  skippedRows   Int          @default(0)
  errorRows     Int          @default(0)
  columnMapping Json?
  errors        Json?
  createdById   String?
  isDemo        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  finishedAt    DateTime?

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([status])
}

/// Structured log of every background job, so failures are visible in the admin UI.
model JobLog {
  id         String    @id @default(cuid())
  jobName    String
  jobId      String?
  queue      String
  status     String
  attempt    Int       @default(1)
  payload    Json?
  result     Json?
  error      String?
  durationMs Int?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([jobName])
  @@index([status])
  @@index([startedAt])
  /// Retention cleanup deletes by age; the admin view filters by job then age.
  @@index([jobName, startedAt])
}
